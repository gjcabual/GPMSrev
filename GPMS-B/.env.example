# Database configuration (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gpmsdb
DB_USER=postgres
DB_PASSWORD=admin

# Optional: Tesseract OCR (for document verification). Set if tesseract is not on PATH (e.g. Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: OCR debug mode. Set to 1 to save preprocessed images and log raw OCR output to result/.
# OCR_DEBUG=0

# Email configuration (optional - required for OTP, password reset, staff invite)
EMAIL_ADDRESS=your@gmail.com
EMAIL_PASSWORD=app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
