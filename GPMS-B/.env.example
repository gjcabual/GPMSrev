# Database configuration (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gpmsdb
DB_USER=postgres
DB_PASSWORD=admin

# Document extraction uses pytesseract. Install Tesseract binary: https://github.com/UB-Mannheim/tesseract/wiki
# Optional: TESSERACT_CONFIG=--psm 6 (e.g. --psm 3 for full auto)
# Optional: DOC_REFERENCE_DIR=path/to/dir containing or_reference.jpg, dl_reference.jpg, cr_reference.png (not required for production)

# Email configuration (optional - required for OTP, password reset, staff invite)
EMAIL_ADDRESS=your@gmail.com
EMAIL_PASSWORD=app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Security hardening (optional)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
